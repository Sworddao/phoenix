    <string name="location_bakery_name">Grandma Mei\'s Bakery</string>
    <string name="location_bakery_description">The warm smell of fresh bread fills the air. Grandma Mei is famous for her mooncakes and steamed buns. She\'ll teach you food vocabulary and how to order treats.</string>
    <string name="location_restaurant_name">Restaurant</string>
    <string name="location_restaurant_description">Owner Lin\'s restaurant serves the best hot pot in the village. Learn to order food, ask about ingredients, and understand menus.</string>
    <string name="location_teahouse_name">Tea House</string>
    <string name="location_teahouse_description">A peaceful place to practice conversation. The tea master will teach you about Chinese tea culture and help you learn polite expressions.</string>
    <string name="location_square_name">Village Square</string>
    <string name="location_square_description">The heart of the village where neighbors gather. A great place to meet new people and practice everyday greetings.</string>
    <string name="location_exit_name">Village Exit</string>
    <string name="location_exit_description">The path leads deeper into China. Once you\'ve made friends here, new adventures await beyond the mountains.</string>
